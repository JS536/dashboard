import { ContentType, Platform } from '../creator/creator.constants';

/**
 * RATE_CONFIG holds every tunable coefficient used by the rate
 * calculator (rate-calculator/rate-calculator.service.ts). The agency
 * can retune pricing by editing values here — no calculation logic
 * needs to change.
 *
 * All monetary figures are in the negotiation's currency (typically INR).
 */
export const RATE_CONFIG = {
  /** ₹ per 1,000 followers, before any platform/content/engagement adjustment. */
  BASE_RATE_PER_1000_FOLLOWERS: 80,

  /** ₹ per 1,000 average views, added into the audience score alongside followers. */
  BASE_RATE_PER_1000_VIEWS: 40,

  /**
   * Engagement rate is a fraction (0.045 = 4.5%). The multiplier for a
   * given rate is the value of the highest bracket whose `minRate` the
   * creator's engagement rate meets or exceeds.
   */
  ENGAGEMENT_MULTIPLIER_TIERS: [
    { minRate: 0.08, multiplier: 1.5 },
    { minRate: 0.05, multiplier: 1.25 },
    { minRate: 0.02, multiplier: 1.0 },
    { minRate: 0, multiplier: 0.8 },
  ] as const,

  /** Multiplicative modifier applied on top of the base rate per platform. */
  PLATFORM_MULTIPLIERS: {
    [Platform.INSTAGRAM]: 1.0,
    [Platform.YOUTUBE]: 1.35,
    [Platform.TIKTOK]: 0.9,
    [Platform.TWITTER]: 0.75,
    [Platform.FACEBOOK]: 0.85,
    [Platform.LINKEDIN]: 1.15,
    [Platform.OTHER]: 1.0,
  } as Record<Platform, number>,

  /** Multiplicative modifier applied on top of the base rate per content type. */
  CONTENT_TYPE_MULTIPLIERS: {
    [ContentType.POST]: 1.0,
    [ContentType.REEL]: 1.15,
    [ContentType.STORY]: 0.5,
    [ContentType.VIDEO]: 1.5,
    [ContentType.SHORT]: 1.1,
    [ContentType.LIVE]: 1.3,
    [ContentType.CAROUSEL]: 1.2,
    [ContentType.BLOG]: 0.9,
    [ContentType.OTHER]: 1.0,
  } as Record<ContentType, number>,

  /**
   * Usage rights fee, as a fraction of the base rate, keyed by the
   * upper bound (in days) of the duration bracket. The first bracket
   * whose `maxDays` is >= the requested duration applies. `Infinity`
   * is the catch-all top bracket.
   */
  USAGE_RIGHTS_MULTIPLIERS: [
    { maxDays: 0, multiplier: 0 }, // no extended usage rights requested
    { maxDays: 30, multiplier: 0.15 },
    { maxDays: 90, multiplier: 0.3 },
    { maxDays: 180, multiplier: 0.5 },
    { maxDays: 365, multiplier: 0.75 },
    { maxDays: Infinity, multiplier: 1.0 }, // perpetual/unlimited usage
  ] as const,

  /** Exclusivity fee, as a fraction of the base rate, keyed the same way as usage rights. */
  EXCLUSIVITY_MULTIPLIERS: [
    { maxDays: 0, multiplier: 0 },
    { maxDays: 30, multiplier: 0.2 },
    { maxDays: 90, multiplier: 0.4 },
    { maxDays: 180, multiplier: 0.65 },
    { maxDays: 365, multiplier: 1.0 },
    { maxDays: Infinity, multiplier: 1.5 },
  ] as const,

  /** Rush delivery adds this fraction of the base rate. */
  RUSH_FEE_MULTIPLIER: 0.25,

  /** First deliverable is included in the base rate; each additional one costs this flat fee. */
  ADDITIONAL_DELIVERABLE_FLAT_FEE: 3000,

  /** Number of revisions included for free before revision fees kick in. */
  FREE_REVISIONS: 1,

  /** Flat fee per revision beyond the free allotment. */
  REVISION_FLAT_FEE: 1500,

  /** Rate is rounded to the nearest multiple of this value for a clean quote. */
  ROUNDING_INCREMENT: 100,
} as const;

export type CampaignModifierType = 'FLAT' | 'PERCENTAGE';

export interface CampaignModifierInput {
  /** Human-readable label, e.g. "Festive season surcharge". Shown in the breakdown. */
  label: string;
  type: CampaignModifierType;
  /** For FLAT: a currency amount. For PERCENTAGE: a fraction of the base rate (0.1 = +10%). */
  value: number;
}
