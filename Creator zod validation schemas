import { z } from 'zod';
import { PLATFORMS, SUPPORTED_CURRENCIES } from './creator.constants';

export const createCreatorSchema = z.object({
  name: z.string().min(1, 'name is required'),
  platform: z.enum(PLATFORMS as [string, ...string[]]),
  followers: z.number().int().min(0, 'followers must be >= 0'),
  averageViews: z.number().int().min(0, 'averageViews must be >= 0'),
  engagementRate: z
    .number()
    .min(0, 'engagementRate must be >= 0')
    .max(1, 'engagementRate must be <= 1 (expressed as a fraction, e.g. 0.045 = 4.5%)'),
  averageGrowthRate: z.number().min(-1).max(5).optional(),
  currency: z.enum(SUPPORTED_CURRENCIES).optional(),
});

export const updateCreatorSchema = createCreatorSchema.partial();

export const creatorIdParamSchema = z.object({
  id: z.string().uuid('id must be a valid UUID'),
});
